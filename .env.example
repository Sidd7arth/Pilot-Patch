# ──────────────────────────────────────────────────────────
# PatchPilot — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env.
# ──────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────
# Replace with your actual PostgreSQL connection string.
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/patchpilot

# ── Session Security ─────────────────────────────────────
# Generate a strong random string (>= 32 chars). Example: openssl rand -hex 32
SESSION_SECRET=

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Qloo API (required for cultural intelligence) ────────
# Obtain your API key from the Qloo team / hackathon portal.
QLOO_API_KEY=
QLOO_API_BASE_URL=
QLOO_TIMEOUT_MS=10000
QLOO_MAX_RETRIES=2
QLOO_MAX_CONCURRENCY=3
QLOO_CACHE_TTL_HOURS=24
QLOO_NEGATIVE_CACHE_TTL_HOURS=1
QLOO_WORKSPACE_DAILY_CALLS=150
QLOO_GLOBAL_DAILY_CALLS=2000

# ── Demo Access ───────────────────────────────────────────
DEMO_ACCESS_CODE=
WORKSPACE_TTL_DAYS=7

# ── LLM (optional — brief narrative generation) ──────────
BRIEF_NARRATIVE_MODE=none
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ── Web (server/build-time only; not a secret) ───────────
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=PatchPilot
